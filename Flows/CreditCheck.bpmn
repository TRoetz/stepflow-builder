<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.12.0">
  <bpmn:process id="credit-check-process" name="Credit Check Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Credit Check Requested">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Gateway_ScoreCheck" />
    
    <bpmn:exclusiveGateway id="Gateway_ScoreCheck" name="Assess Score" default="Flow_Reject">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_ApproveDirect</bpmn:outgoing>
      <bpmn:outgoing>Flow_AICheck</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="Flow_ApproveDirect" name="Score &#62;= 700" sourceRef="Gateway_ScoreCheck" targetRef="Task_AutoApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditScore &gt;= 700</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:serviceTask id="Task_AutoApprove" name="Approve Automatically">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="approve-service" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApproveDirect</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd1</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="Flow_ToEnd1" sourceRef="Task_AutoApprove" targetRef="Flow_End1" />
    
    <bpmn:endEvent id="Flow_End1" name="Approved">
      <bpmn:incoming>Flow_ToEnd1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_AICheck" name="Score 600 - 699" sourceRef="Gateway_ScoreCheck" targetRef="Task_AIReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditScore &gt;= 600 and creditScore &lt; 700</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    
    <bpmn:serviceTask id="Task_AIReview" name="AI Assessment (Missed Payments)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ai-history-assessment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AICheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd2</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="Flow_ToEnd2" sourceRef="Task_AIReview" targetRef="Flow_End2" />
    
    <bpmn:endEvent id="Flow_End2" name="AI Evaluated">
      <bpmn:incoming>Flow_ToEnd2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Reject" name="Score &#60; 600" sourceRef="Gateway_ScoreCheck" targetRef="Task_AutoReject" />
    
    <bpmn:serviceTask id="Task_AutoReject" name="Reject Automatically">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reject-service" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd3</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:sequenceFlow id="Flow_ToEnd3" sourceRef="Task_AutoReject" targetRef="Flow_End3" />
    
    <bpmn:endEvent id="Flow_End3" name="Rejected">
      <bpmn:incoming>Flow_ToEnd3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
