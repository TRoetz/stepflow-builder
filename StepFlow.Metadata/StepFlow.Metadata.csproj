<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet packaging: StepFlow.Metadata — attribute domains, schema definitions and their persistence -->
    <IsPackable>true</IsPackable>
    <PackageId>StepFlow.Metadata</PackageId>
    <Version>1.0.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>StepFlow Builder</Authors>
    <Description>Attribute domain + schema definition contracts (entity attribute metadata) with JSON and SQLite persistence providers, shared by StepFlow forms, EAV datasets and DataExchange pipelines.</Description>
    <PackageTags>stepflow;metadata;attribute-domains;schemas</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StepFunctionsApp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
