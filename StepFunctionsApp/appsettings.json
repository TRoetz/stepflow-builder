{
  "FlowState": {
    "Provider": "disk",
    "DiskPath": "flow-state",
    "RedisConnection": "localhost:6379",
    "AutoResume": true
  },
  "HumanTasks": {
    "DiskPath": "flow-state/human-tasks",
    "PollIntervalSeconds": 5,
    "FileMonitorDefaultDirectory": "human-task-completions"
  },
  "FormData": {
    "Provider": "sqlite"
  },
  // Logical sql:// datasource names -> SQLite file paths (env vars %NAME% / ${NAME} supported).
  // Flows reference these by name (e.g. resource "sql://fees") so the same flow definition
  // deploys to any environment; each environment binds the name to its own database file.
  // Literal sql://<path> URIs still work and win when that file exists.
  "SqlDataSources": {
    "fees": "fees.db"
  },
  "Workspace": {
    "RootDirectory": "workspace-data",
    "DefaultNodeName": "Default"
  },
  "Callback": {
    "BaseUrl": ""
  },
  "Eav": {
    "RegistryPath": "eav_registry.json",
    "DataDirectory": "eav-data"
  },
  "Rules": {
    "Path": "rules.json"
  },
  "Ssh": {
    "HostsFile": "ssh_hosts.json"
  },
  "AiDecision": {
    "BaseUrl": "",
    "Model": ""
  },
  "DynamicApi": {
    "ManagementPort": 5001,
    "ListenAddress": "localhost",
    "Endpoints": [
      { "Port": 5101, "NodePath": "Acme UI/Website" }
    ]
  }
}
