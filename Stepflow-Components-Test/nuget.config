<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Published StepFlow packages (local feed) -->
    <add key="stepflow-local" value="C:\Source\stepflow-builder\nupkgs" />
    <!-- Fallback for anything not in the global cache; all declared deps are cached, so this is normally never hit. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
