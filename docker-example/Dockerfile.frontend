# StepFlow Builder UI (Vite/React). Build context = repo root.
FROM node:22-alpine AS build
WORKDIR /app
COPY StepFlow-UI/package.json StepFlow-UI/package-lock.json StepFlow-UI/.npmrc ./ui/
RUN cd ui && npm ci
COPY StepFlow-UI/ ./ui/
RUN cd ui && npm run build

FROM nginx:alpine
COPY --from=build /app/ui/dist /usr/share/nginx/html
COPY docker-example/deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
